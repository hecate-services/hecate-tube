%% Substituted by relx at boot; every ${VAR} must resolve or the node will not
%% start with a malformed term. That is the correct failure: a service with a
%% half-configured realm announces itself where nobody can attribute it, which
%% looks exactly like a healthy node.
[
    {hecate_om, [
        {service_cert_path, "/etc/hecate/secrets/service-cert.pem"},
        {station_socket,    "/run/macula/station.sock"},
        {health_port,       ${HECATE_HEALTH_PORT}},
        {capability_topic,  <<"_mesh.cap.">>},
        %% Without this, hecate_om_identity:keypair/0 stays {error,
        %% no_keypair} forever (hecate_om >= 0.14.1 self-heals by
        %% generating+persisting one here on first boot, but only once
        %% a path is actually configured) -- and this service's whole
        %% job is a direct-dial RPC/Streaming PROVIDER, which cannot
        %% sign an advertisement without a stable keypair. Confirmed
        %% live: tube_mesh_providers retried every 5s and never once
        %% succeeded, silently, since this service's first deployment,
        %% before this line existed. Under `${HECATE_DATA_DIR}' (the
        %% same persistent volume clips/tube_store already live on),
        %% not `/etc/hecate/secrets' -- this is a self-generated
        %% peering identity, not an operator-provisioned credential.
        {identity_key_path, "${HECATE_DATA_DIR}/identity/keypair.erl.bin"},
        %% THE REALM IS AN APPLICATION ENV, NOT A SHELL VARIABLE, and this file
        %% is the only place the two meet. hecate_om_identity:realm() reads
        %% application:get_env(hecate_om, realm); exporting HECATE_REALM in the
        %% shell and expecting that to be enough has cost a sibling service an
        %% hour, because nothing translates between the two by itself.
        {realm,             <<"${HECATE_REALM}">>}
    ]},

    %% hecate-tube's own QRY read API, distinct from hecate_om's health_port.
    {hecate_tube, [
        {http_port, ${HECATE_HTTP_PORT}}
    ]},

    %% ==========================================================================
    %% EVOQ'S ADAPTER, WITHOUT WHICH THIS NODE DOES NOT BOOT
    %% ==========================================================================
    %%
    %% MANDATORY because hecate_tube_service exports store_id/0. hecate_om:boot/1
    %% starts the store AND a per-store evoq subscription, which reads the
    %% global log through evoq and crashes on {not_configured,
    %% event_store_adapter} if this block is absent -- see hecate_om_store's
    %% own module header.
    {evoq, [
        {event_store_adapter,    reckon_evoq_adapter},
        {subscription_adapter,   reckon_evoq_adapter},
        {snapshot_store_adapter, reckon_evoq_adapter},
        {store_id,               tube_store}
    ]},

    {kernel, [{logger_level, info}]}
].
