%% Literal config for local dev: `rebar3 shell' / `rebar3 eunit'. The real
%% release boots from config/sys.config.src instead (relx substitutes
%% ${VAR}s at container start) -- this file is NOT used there.
[
    {hecate_om, [
        {service_cert_path, "/etc/hecate/secrets/service-cert.pem"},
        {health_port,       8490},
        %% No station_seeds configured: hecate_om_identity degrades to
        %% {error, no_client} and the service stays up mesh-dark. Fine for
        %% local dev of the CMD/PRJ/QRY walking skeleton; mesh integration
        %% is exercised via hecate-testkit instead (from Phase 2 onward).
        {station_seeds,     []},
        {realm,             <<0:256>>}
    ]},

    {hecate_tube, [
        {http_port, 8491}
    ]},

    {evoq, [
        {event_store_adapter,    reckon_evoq_adapter},
        {subscription_adapter,   reckon_evoq_adapter},
        {snapshot_store_adapter, reckon_evoq_adapter},
        {store_id,               tube_store}
    ]},

    {kernel, [{logger_level, info}]}
].
