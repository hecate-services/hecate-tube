{application, hecate_tube, [
    {description, "YouTube over mesh -- a channel/video service exercising every macula primitive pair"},
    {vsn, "0.1.0"},
    {registered, [hecate_tube_sup]},
    {mod, {hecate_tube_app, []}},
    {applications, [
        kernel,
        stdlib,
        crypto,
        cowboy,
        %% Mesh SDK, realm identity, capabilities, health.
        hecate_om,
        %% Department apps, boot-ordered before this one so
        %% hecate_tube_service:start/1's ensure_store/ensure_subscription
        %% (via hecate_om:boot/1) finds them already up.
        guide_tube_lifecycle,
        project_tube,
        query_tube
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/hecate-services/hecate-tube"}]}
]}.
