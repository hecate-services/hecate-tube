%% -*- mode: erlang -*-
%% rebar3 configuration for hecate_tube.
%%
%% YouTube over mesh -- a channel/video service exercising every macula primitive pair
%%
%% Generated by `rebar3 new hecate_service'. The scaffold boots, joins the mesh
%% and answers /health; it does nothing else yet.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The shared L2 substrate: mesh SDK, realm identity, capabilities, health.
    %% hecate_tube_service exports store_id/0 + data_dir/0, so hecate_om:boot/1
    %% starts reckon-db + the evoq subscription before start/1 runs.
    %% ~> 0.14 for hecate_om:mesh_handles/0 + realm/0 + keypair/0, which every
    %% mesh emitter and direct-dial provider desk in this repo calls.
    {hecate_om, "~> 0.14"},

    %% Declared directly (not just pulled in transitively via hecate_om) because
    %% hecate-tube calls macula's supervised pubsub/content/streaming/RPC-provider
    %% wrappers straight from its own desk modules -- hecate_om only wraps the RPC
    %% consumer side today. See plans/PLAN_MACULA_API_INTEGRATION_SURVEY.md in
    %% hecate-om. ~> 10.0: macula-net removal, unrelated to anything this repo uses.
    {macula, "~> 10.0"},

    %% CMD/PRJ event sourcing, matching the workspace's current compatibility
    %% matrix (reckon_db ~> 5.9 / evoq ~> 1.23).
    {reckon_db, "~> 5.9"},
    {evoq, "~> 1.23"},

    %% QRY's local JSON HTTP surface. Tight ~> 2.12.0 (not ~> 2.12), matching
    %% hecate-mpong-bot/hecate-llm: a looser range resolves cowboy 2.18+,
    %% whose cowlib requirement conflicts with what macula/hecate_om pin.
    {cowboy, "~> 2.12.0"}
]}.

{project_plugins, [rebar3_lint]}.

%% The org's structural ruleset, matching the sibling services.
{elvis, [
    {rulesets, #{
        hecate_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => hecate_min}
    ]}
]}.

{eunit_opts, [verbose]}.

%% `config/sys.config' is a literal dev config, distinct from the
%% `${VAR}'-templated `config/sys.config.src' relx substitutes at release
%% boot -- this is what `rebar3 shell' loads.
{shell, [
    {config, "config/sys.config"},
    {apps, [hecate_tube]}
]}.

{relx, [
    %% Department apps before the top-level app, same ordering rationale as
    %% hecate-mpong-bot: CMD/PRJ/QRY must be up before hecate_tube_service:start/1
    %% runs ensure_store/ensure_subscription.
    {release, {hecate_tube, "0.1.0"}, [
        hecate_tube,
        hecate_om,
        guide_tube_lifecycle,
        project_tube,
        query_tube,
        sasl
    ]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]},

    {test, [
        {deps, [{meck, "~> 0.9"}]}
    ]},

    %% test_live/*.erl hit a real demo-fleet station
    %% (station-de-frankfurt.macula.io) over the network -- valuable
    %% precisely because they exercise the real macula_feeder put +
    %% real RPC dispatch, which a mocked-mesh unit test cannot -- but
    %% NOT safe as an unconditional CI gate: the demo fleet is
    %% documented, disposable dev infra with no uptime guarantee.
    %% Same convention as hecate-om's test_live/. Run explicitly:
    %%   rebar3 as live_test eunit --dir test_live
    {live_test, [
        {extra_src_dirs, ["test_live"]},
        {deps, [{meck, "~> 0.9"}]}
    ]}
]}.
